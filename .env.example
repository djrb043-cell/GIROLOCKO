# Copie este arquivo para ".env" e preencha (Firebase Console > Configurações do projeto > Seus apps > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Só para a Netlify (funções do servidor). Vêm do JSON da "Conta de serviço" do Firebase.
# NÃO coloque isso no código nem suba para o GitHub.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
